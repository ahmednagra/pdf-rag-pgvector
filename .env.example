# Copy to .env and fill in what you need. Never commit .env.
# With no changes at all the service runs fully offline:
#   local embeddings (fastembed) + the extractive answer baseline.

# --- Embeddings ---------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed          # fastembed | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # for openai use text-embedding-3-small
# EMBEDDING_API_KEY=                  # only for EMBEDDING_PROVIDER=openai

# --- Answer generation -----------------------------------------------------------
LLM_PROVIDER=extractive               # extractive | openai | gemini | anthropic
# LLM_MODEL=gpt-4.1-mini              # e.g. gemini-2.5-flash, claude-haiku-5-5
# LLM_API_KEY=
# LLM_BASE_URL=                       # optional: any other OpenAI-compatible endpoint
# LLM_TEMPERATURE=                    # default: 0, omitted for anthropic

# --- Ports on your machine ---------------------------------------------------------
# API_PORT=8080
# DB_PORT=5433
